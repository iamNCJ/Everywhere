{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "T=$(mktemp); cat > \"$T\"; (python3 -u \"${CODEX_PLUGIN_ROOT}/hooks/codex_hook.py\" stop < \"$T\" >/dev/null 2>&1; rm -f \"$T\") &",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "T=$(mktemp); cat > \"$T\"; (python3 -u \"${CODEX_PLUGIN_ROOT}/hooks/codex_hook.py\" finalize-sweep < \"$T\" >/dev/null 2>&1; rm -f \"$T\") &",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
