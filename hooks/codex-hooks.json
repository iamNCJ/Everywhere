{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "nohup python3 -u \"${CODEX_PLUGIN_ROOT}/hooks/codex_hook.py\" stop >/dev/null 2>&1 &",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "nohup python3 -u \"${CODEX_PLUGIN_ROOT}/hooks/codex_hook.py\" finalize-sweep >/dev/null 2>&1 &",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
